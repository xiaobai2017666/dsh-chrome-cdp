{
  "name": "dsh-chrome-cdp",
  "description": "Chrome DevTools Protocol connection panel for DeepSeek Harness — manage a chrome-remote-interface connection from the Web UI.",
  "version": "0.2.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./tools": "./lib/tools.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./bridge": "./bridge.mjs"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "src",
    "presets",
    "bridge.mjs",
    "bridge.d.mts"
  ],
  "scripts": {
    "build": "tsdown && node scripts/normalize-client-banner.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.34.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-alpha.3",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-store": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-alpha.3",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.33.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh-attachment": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.3"
  }
}
